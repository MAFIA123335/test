# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ─── Database (Supabase / PostgreSQL) ───────────────────
# 👉 THE ONLY REQUIRED VALUE: your database connection string.
#    A single URL is enough — DIRECT_URL is optional (falls back to this).
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
DIRECT_URL=""

# ─── Auto setup (zero-config) ───────────────────────────
# On boot: run migrations + seed demo data if DB is empty. Set to false to disable.
AUTO_MIGRATE=true
AUTO_SEED=true

# ─── JWT ────────────────────────────────────────────────
# Leave blank and the server generates random secrets at boot (fine for demos).
# Set explicit long random strings in production to keep sessions across restarts.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=30m

# ─── Bcrypt ─────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ───────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Cookies ────────────────────────────────────────────
COOKIE_SECRET=
COOKIE_SECURE=false

# ─── Supabase Storage (OPTIONAL — leave blank to skip) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=beauty-center

# ─── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Misc ───────────────────────────────────────────────
LOG_LEVEL=info
LOW_STOCK_THRESHOLD=5
